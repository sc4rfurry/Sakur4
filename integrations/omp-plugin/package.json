  "bugs": {
    "url": "https://github.com/sakur4/sakur4/issues"
  },
  "keywords": [
    "pi-package",
    "pi-extension",
    "omp",
    "sakur4",
    "memory",
    "context",
    "llama-cpp"
  ],
  "files": [
    "index.ts",
    "README.md",
    "LICENSE"
  ],
  "pi": {
    "extensions": [
      "./index.ts"
    ]
  },
  "scripts": {
